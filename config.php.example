<?php
/**
 * HopeLine Configuration Example
 * Rename this file to config.php and fill in your actual credentials.
 */

define('DB_HOST', 'localhost');
define('DB_NAME', 'hopeline');
define('DB_USER', 'root');
define('DB_PASS', ''); // Default XAMPP has no password

// Your LongCat AI API settings
// Get your key from your LongCat dashboard
define('AI_API_KEY', 'YOUR_API_KEY_HERE'); 
define('AI_API_URL', 'https://api.longcat.chat/openai/v1/chat/completions');
define('AI_MODEL', 'LongCat-Flash-Chat'); // Fast conversational model — recommended

// Session Configuration
define('SESSION_NAME', 'hopeline_sess');

// Start session
session_name(SESSION_NAME);
session_start();

// DB connection (PDO)
try {
    $pdo = new PDO(
        "mysql:host=" . DB_HOST . ";dbname=" . DB_NAME . ";charset=utf8mb4",
        DB_USER,
        DB_PASS,
        [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_EMULATE_PREPARES => false,
        ]
    );
} catch (PDOException $e) {
    http_response_code(500);
    die(json_encode(['error' => 'Database connection failed.']));
}

/**
 * Helper Functions
 */

function is_logged_in() {
    return isset($_SESSION['user_id']);
}

function require_login() {
    if (!is_logged_in()) {
        header('Location: index.php');
        exit;
    }
}

function e($str) {
    return htmlspecialchars($str, ENT_QUOTES, 'UTF-8');
}
